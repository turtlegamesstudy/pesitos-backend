# ============ Pesitos backend · variables de entorno ============
# (en Render: pegar cada una en Environment → Secret file / env vars)

# Cuenta de servicio (admin SDK). DOS formatos aceptados:
#   a) JSON completo en una línea (con comillas escapadas), o
#   b) el mismo JSON en base64
# NUNCA lo subas al repositorio.
FB_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=inclave-913cd

# PayPal PRODUCCIÓN (server-side). El SECRET jamás va al cliente.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live
PAYPAL_RATE=36.5
PAYPAL_RETURN_URL=https://pesitos.web.app/

# Origen permitido por CORS (tu dominio del casino)
CORS_ORIGIN=https://pesitos.web.app

# Puerto (Render lo asigna; local por defecto 3001)
PORT=3001
